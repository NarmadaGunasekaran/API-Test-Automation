{
  "name": "github-pull-request-tests",
  "version": "1.0.0",
  "private": true,
  "scripts": {
    "test": "playwright test",
    "test:deterministic": "playwright test --grep-invert @live",
    "test:live": "playwright test --grep @live",
    "test:headed": "playwright test --headed",
    "test:report": "playwright show-report",
    "typecheck": "tsc --noEmit"
  },
  "devDependencies": {
    "@playwright/test": "^1.64.1",
    "@types/node": "^24.19.2",
    "typescript": "^5.9.3"
  },
  "dependencies": {
    "zod": "^4.6.7"
  }
}
